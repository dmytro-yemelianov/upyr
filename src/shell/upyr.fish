# Upyr shell widgets: fix text typed on the wrong keyboard layout at the
# prompt. Generated by `upyr shell-init fish`; load it from
# ~/.config/fish/config.fish with
#   upyr shell-init fish | source
#
#   Ctrl+X Ctrl+L  convert the whole command line
#   Ctrl+X L       convert the word before the cursor
#
# Set UPYR_NO_BINDINGS=1 before loading to bind the functions yourself:
#   bind <keys> upyr-convert-line   /   upyr-convert-word

if set -q UPYR_BIN
    set -g _upyr_bin $UPYR_BIN
else
    set -g _upyr_bin @UPYR_BIN@
end

# Prints $argv[1] converted. The installed layouts are preferred; the
# built-in table is the fallback.
function _upyr_convert
    $_upyr_bin convert --installed -- $argv[1] 2>/dev/null
    or $_upyr_bin convert -- $argv[1] 2>/dev/null
end

function upyr-convert-line
    set -l line (commandline | string collect)
    test -n "$line"; or return 0
    set -l cursor (commandline -C)
    set -l converted (_upyr_convert "$line" | string collect); or return 1
    commandline -r -- $converted
    # Layout conversion maps one character to one character.
    commandline -C $cursor
end

function upyr-convert-word
    set -l left (commandline -c | string collect)
    set -l line (commandline | string collect)
    set -l right (string sub -s (math (string length -- "$left") + 1) -- "$line")
    set -l trimmed (string replace -r '\s+$' '' -- "$left")
    set -l spaces (string sub -s (math (string length -- "$trimmed") + 1) -- "$left")
    set -l word (string match -r '\S+$' -- "$trimmed")
    test -n "$word"; or return 0
    set -l prefix (string sub -l (math (string length -- "$trimmed") - (string length -- "$word")) -- "$trimmed")
    set -l converted (_upyr_convert "$word" | string collect); or return 1
    commandline -r -- "$prefix$converted$spaces$right"
    commandline -C (string length -- "$prefix$converted$spaces")
end

if not set -q UPYR_NO_BINDINGS
    for mode in default insert
        bind -M $mode \cx\cl upyr-convert-line
        bind -M $mode \cxl upyr-convert-word
    end
end
