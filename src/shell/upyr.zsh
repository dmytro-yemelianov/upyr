# Upyr shell widgets: fix text typed on the wrong keyboard layout at the
# prompt. Generated by `upyr shell-init zsh`; load it from ~/.zshrc with
#   eval "$(upyr shell-init zsh)"
#
#   Ctrl+X Ctrl+L  convert the whole command line
#   Ctrl+X L       convert the word before the cursor, or the active region
#
# Set UPYR_NO_BINDINGS=1 before loading to bind the widgets yourself:
#   bindkey '<keys>' upyr-convert-line   /   upyr-convert-word

typeset -g _upyr_bin=${UPYR_BIN:-@UPYR_BIN@}

# Converts $1 and leaves the result in $REPLY. The installed layouts are
# preferred; the built-in table is the fallback.
_upyr_convert() {
  REPLY=$("$_upyr_bin" convert --installed -- "$1" 2>/dev/null) ||
    REPLY=$("$_upyr_bin" convert -- "$1" 2>/dev/null)
}

upyr-convert-line() {
  [[ -n $BUFFER ]] || return 0
  local REPLY cursor=$CURSOR
  _upyr_convert "$BUFFER" || return 1
  BUFFER=$REPLY
  # Layout conversion maps one character to one character.
  CURSOR=$(( cursor < ${#BUFFER} ? cursor : ${#BUFFER} ))
}

upyr-convert-word() {
  setopt localoptions extendedglob
  local REPLY
  if (( REGION_ACTIVE )); then
    local start=$(( MARK < CURSOR ? MARK : CURSOR ))
    local end=$(( MARK < CURSOR ? CURSOR : MARK ))
    (( end > start )) || return 0
    _upyr_convert "${BUFFER:$start:$(( end - start ))}" || return 1
    BUFFER=${BUFFER:0:$start}$REPLY${BUFFER:$end}
    REGION_ACTIVE=0
    CURSOR=$(( start + ${#REPLY} ))
    return 0
  fi
  local trimmed=${LBUFFER%%[[:space:]]#}
  local spaces=${LBUFFER:${#trimmed}}
  local word=${trimmed##*[[:space:]]}
  [[ -n $word ]] || return 0
  _upyr_convert "$word" || return 1
  LBUFFER=${trimmed:0:$(( ${#trimmed} - ${#word} ))}$REPLY$spaces
}

zle -N upyr-convert-line
zle -N upyr-convert-word
if [[ -z $UPYR_NO_BINDINGS ]]; then
  bindkey '^X^L' upyr-convert-line
  bindkey '^Xl' upyr-convert-word
fi
